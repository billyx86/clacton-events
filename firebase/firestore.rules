rules_version = '2';

// Firestore security rules for Clacton Events.
//
// Shape:
//   /events/{eventId}   public read. Writes are author-scoped (issue #16):
//                       only the user whose email is stored in the event's
//                       `emailOfAuthor` field may update or delete it, and a
//                       create must set that field to the writer's own email.
//   /users/{email}      owner-only read/write. The document ID is the user's
//                       email address, and the display name rendered on event
//                       cards comes from the event's own `author` field, so no
//                       client path needs to read another user's profile.
//   /counters/{name}    never directly readable or writable by clients — the
//                       counter is advanced inside the create-event
//                       transaction and client code never reads it.
//
// Deploy with:  npx firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default; allow only what's spelled out below.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Events -------------------------------------------------------
    // Events are public content: anyone (including signed-out visitors) may
    // read them. Writes are scoped to the author (issue #16): an event's
    // `emailOfAuthor` field is set to the creator's email on write (see
    // EventForm.handleSubmit), so only that user may update or delete the
    // event. `emailOfAuthor` is immutable — an update may not change who
    // owns the event, which is what makes the delete rule safe.
    //
    // Note: events created before `emailOfAuthor` existed have no owner
    // claim and are therefore uneditable by anyone (fail-closed). A one-off
    // backfill of that field is required to restore ownership of legacy
    // events; see the "Legacy events" note in the README data model.
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if request.auth != null
        && request.resource.data.emailOfAuthor == request.auth.token.email;
      allow update: if request.auth != null
        && request.auth.token.email == resource.data.emailOfAuthor
        && request.resource.data.emailOfAuthor == resource.data.emailOfAuthor;
      allow delete: if request.auth != null
        && request.auth.token.email == resource.data.emailOfAuthor;
    }

    // ---- Users --------------------------------------------------------
    // Owner-only: only the user whose email is the document ID may read or
    // modify their profile. (No `list` permission — an unfiltered list can't
    // be scoped to the owner's doc, and no client path needs it.) Deletion is
    // denied — profile docs outlive the events they authored.
    match /users/{email} {
      allow get: if request.auth != null
        && request.auth.token.email == email;
      allow create, update: if request.auth != null
        && request.auth.token.email == email;
      allow delete: if false;
    }

    // ---- Counters -----------------------------------------------------
    // The eventCounter document is maintained inside the create-event
    // transaction. Clients never read or write it directly, so close it
    // completely (a client-side update() on a missing doc would otherwise
    // be a useful attack surface for poisoning the sort counter).
    match /counters/{counterName} {
      allow read, write: if false;
    }
  }
}
