# Copy to .env and fill in your Firebase web app credentials.
# The REACT_APP_ prefix is required — Vite is configured with
# envPrefix: 'REACT_APP_' (see vite.config.mjs) so existing CRA-style
# env vars keep working.
REACT_APP_FIREBASE_API_KEY=
REACT_...AIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_MEASUREMENT_ID=

# Google Static Maps / Places key (event form autocomplete + detail map)
REACT_APP_GMAPS_STATIC_KEY=
