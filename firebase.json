{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"],
      "predeploy": []
    }
  ],
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 18081
    },
    "ui": {
      "enabled": false
    }
  }
}
